# ==============================================================================
# UnifAI Enterprise Centralized Configuration (.env)
# ==============================================================================
# This is the single master configuration file for UnifAI.
# When deploying for a new company/client, customize the values below.
# No code files need to be modified.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Public Domain
# ------------------------------------------------------------------------------
# The public domain / base URL of your UnifAI instance (used by Dashboard, MCP & Guard)
SERVER_DOMAIN=https://unifaiv2.dev-yp.com

# Backend HTTP API port (default: 8081)
APP_PORT=8081

# Server listen host (0.0.0.0 to allow external/container traffic)
APP_HOST=0.0.0.0

# Optional Browser Proxy port (LAB/demo proxy)
PROXY_PORT=8082


# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Database engine: postgres
DB_TYPE=postgres

# Database host IP or domain
DB_HOST=76.13.243.253

# Database port (PostgreSQL default is usually 5432 or custom port)
DB_PORT=32768

# Database name
DB_NAME=Unifai_test

# Database user
DB_USER=Unifai_test

# Database password
DB_PASSWORD=YP2025-2026yp

# SSL mode: disable, require, verify-ca, verify-full
DB_SSL_MODE=disable


# ------------------------------------------------------------------------------
# 3. AI Engine & Ollama Configuration
# ------------------------------------------------------------------------------
# URL to your internal or external Ollama LLM service
# Example for Docker host: http://host.docker.internal:11434
# Example for 1Panel container: http://1Panel-ollama-IjuM:11434
OLLAMA_URL=http://1Panel-ollama-IjuM:11434


# ------------------------------------------------------------------------------
# 4. Initial Administrator Account
# ------------------------------------------------------------------------------
# Admin user credentials for first-time dashboard login
ADMIN_EMAIL=admin@yespanchi.com
ADMIN_PASSWORD=YP2025-2026yp


# ------------------------------------------------------------------------------
# 5. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log style: json (production) or console (development)
LOG_STYLE=json

# Runtime data directory inside container
APP_DIR=/app/data
